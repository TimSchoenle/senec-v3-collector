# https://git-scm.com/docs/gitattributes

# ------------------------------------------------------------------------------
# Default behavior
# ------------------------------------------------------------------------------
# Let Git detect text files and normalize line endings to LF in the repository.
# Checkout uses the platform-native line ending unless overridden below.
* text=auto eol=lf

# ------------------------------------------------------------------------------
# Source code
# ------------------------------------------------------------------------------
*.rs        text diff=rust
*.toml      text diff=toml
*.hbs       text

# ------------------------------------------------------------------------------
# Documentation
# ------------------------------------------------------------------------------
*.md        text diff=markdown
*.txt       text
LICENSE     text
SECURITY.md text
README.md   text
CHANGELOG.md text linguist-generated

# ------------------------------------------------------------------------------
# Config / data formats
# ------------------------------------------------------------------------------
*.yml       text
*.yaml      text
*.json      text
*.jsonc     text
*.env       text
*.gitignore text
*.gitattributes text
.dockerignore text
.editorconfig text

# ------------------------------------------------------------------------------
# Docker
# ------------------------------------------------------------------------------
Dockerfile        text
Dockerfile.*      text
*.dockerfile      text

# ------------------------------------------------------------------------------
# Lockfiles and other generated artifacts
# ------------------------------------------------------------------------------
Cargo.lock text linguist-generated merge=binary
deploy/profiles/generated/**  linguist-generated -diff

# ------------------------------------------------------------------------------
# JetBrains project files (not authored by hand, generated by the IDE)
# ------------------------------------------------------------------------------
*.iml text linguist-generated
.idea/**  linguist-generated

# ------------------------------------------------------------------------------
# Linguist overrides for GitHub language statistics
# ------------------------------------------------------------------------------
docs/**                     linguist-documentation
deploy/grafana/dashboards/** linguist-generated
*.hbs                        linguist-language=Handlebars

# ------------------------------------------------------------------------------
# Ensure shell/CI scripts, if introduced, always keep LF endings
# ------------------------------------------------------------------------------
*.sh   text eol=lf
*.bash text eol=lf

# ------------------------------------------------------------------------------
# Windows-specific scripts always keep CRLF endings
# ------------------------------------------------------------------------------
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# ------------------------------------------------------------------------------
# Binary files: never touch line endings, never run textual diff
# ------------------------------------------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.svg  binary
*.woff binary
*.woff2 binary
*.ttf  binary
*.eot  binary
*.pdf  binary
*.zip  binary
*.gz   binary
*.tar  binary
*.7z   binary
*.exe  binary
*.dll  binary
*.so   binary
*.dylib binary

# ------------------------------------------------------------------------------
# Placeholder files used only to keep otherwise empty directories under version control
# ------------------------------------------------------------------------------
.gitkeep text
